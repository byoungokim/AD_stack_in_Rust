    <!-- ============ PEDESTRIAN ACTORS (scripted, kinematic) ============ -->

    <actor name="ped_cross_west">
      <link name="body">
        <visual name="visual">
          <pose>0 0 0.75 0 0 0</pose>
          <geometry><cylinder><radius>0.15</radius><length>1.5</length></cylinder></geometry>
          <material><ambient>0.9 0.75 0.2 1</ambient><diffuse>0.9 0.75 0.2 1</diffuse></material>
        </visual>
      </link>
      <script>
        <loop>true</loop>
        <auto_start>true</auto_start>
        <trajectory id="0" type="walk">
        <waypoint><time>0.00</time><pose>-4.0 -3.5 0 0 0 1.571</pose></waypoint>
        <waypoint><time>17.50</time><pose>-4.0 3.5 0 0 0 -1.571</pose></waypoint>
