        <waypoint><time>0.00</time><pose>8.0 3.0 0 0 0 3.142</pose></waypoint>
        <waypoint><time>10.86</time><pose>4.2 3.0 0 0 0 0.000</pose></waypoint>
        <waypoint><time>21.71</time><pose>8.0 3.0 0 0 0 3.142</pose></waypoint>
        </trajectory>
      </script>
    </actor>

    <!-- ============ LIMO PRO ROBOT ============ -->
    <!-- Spawn on the west end of the main avenue, facing east.
         Planning/odom frame origin = this spawn pose (yaw 0), so
         scenario waypoints are world coords minus (-8.0, 0.0). -->
    <include>
      <uri>model://limo_pro</uri>
      <name>limo</name>
      <pose>-8.0 0.0 0.055 0 0 0</pose>
    </include>

  </world>
</sdf>
