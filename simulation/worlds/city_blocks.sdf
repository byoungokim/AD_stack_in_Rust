    <model name="ped_0_cross">
      <pose>-12.750 -7.250 0 0 0 0</pose>
      <link name="body">
        <kinematic>true</kinematic>
        <collision name="collision">
          <pose>0 0 0.75 0 0 0</pose>
          <geometry><cylinder><radius>0.15</radius><length>1.5</length></cylinder></geometry>
