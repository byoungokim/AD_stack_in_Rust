          <material><ambient>1.0 0.5 0.0 1</ambient><diffuse>1.0 0.6 0.0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="slalom_cone_3">
      <static>true</static>
      <pose>-3.8 -0.35 0.175 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.15</radius><length>0.35</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.15</radius><length>0.35</length></cylinder></geometry>
          <material><ambient>1.0 0.5 0.0 1</ambient><diffuse>1.0 0.6 0.0 1</diffuse></material>
        </visual>
