    <!-- ============ PEDESTRIAN ACTORS ============ -->

    <actor name="ped_cross_1">
      <link name="body">
        <visual name="visual">
          <pose>0 0 0.75 0 0 0</pose>
          <geometry><cylinder><radius>0.15</radius><length>1.5</length></cylinder></geometry>
          <material><ambient>0.9 0.75 0.2 1</ambient><diffuse>0.9 0.75 0.2 1</diffuse></material>
        </visual>
      </link>
      <script>
        <loop>true</loop>
        <auto_start>true</auto_start>
        <trajectory id="0" type="walk">
        <waypoint><time>0.00</time><pose>0.8 -3.4 0 0 0 1.571</pose></waypoint>
        <waypoint><time>17.00</time><pose>0.8 3.4 0 0 0 -1.571</pose></waypoint>
        <waypoint><time>34.00</time><pose>0.8 -3.4 0 0 0 1.571</pose></waypoint>
        </trajectory>
      </script>
    </actor>

    <actor name="ped_cross_2">
      <link name="body">
        <visual name="visual">
          <pose>0 0 0.75 0 0 0</pose>
          <geometry><cylinder><radius>0.15</radius><length>1.5</length></cylinder></geometry>
          <material><ambient>0.2 0.55 0.9 1</ambient><diffuse>0.2 0.55 0.9 1</diffuse></material>
        </visual>
      </link>
      <script>
        <loop>true</loop>
        <auto_start>true</auto_start>
        <trajectory id="0" type="walk">
        <waypoint><time>0.00</time><pose>2.2 3.4 0 0 0 -1.571</pose></waypoint>
        <waypoint><time>13.60</time><pose>2.2 -3.4 0 0 0 1.571</pose></waypoint>
        <waypoint><time>27.20</time><pose>2.2 3.4 0 0 0 -1.571</pose></waypoint>
        </trajectory>
      </script>
    </actor>

    <actor name="ped_cross_3">
      <link name="body">
        <visual name="visual">
          <pose>0 0 0.75 0 0 0</pose>
          <geometry><cylinder><radius>0.15</radius><length>1.5</length></cylinder></geometry>
          <material><ambient>0.9 0.75 0.2 1</ambient><diffuse>0.9 0.75 0.2 1</diffuse></material>
        </visual>
      </link>
      <script>
        <loop>true</loop>
        <auto_start>true</auto_start>
        <trajectory id="0" type="walk">
        <waypoint><time>0.00</time><pose>3.4 -3.4 0 0 0 1.571</pose></waypoint>
        <waypoint><time>19.43</time><pose>3.4 3.4 0 0 0 -1.571</pose></waypoint>
        <waypoint><time>38.86</time><pose>3.4 -3.4 0 0 0 1.571</pose></waypoint>
        </trajectory>
      </script>
    </actor>

    <actor name="ped_wanderer">
      <link name="body">
        <visual name="visual">
          <pose>0 0 0.75 0 0 0</pose>
          <geometry><cylinder><radius>0.15</radius><length>1.5</length></cylinder></geometry>
          <material><ambient>0.2 0.55 0.9 1</ambient><diffuse>0.2 0.55 0.9 1</diffuse></material>
        </visual>
      </link>
      <script>
        <loop>true</loop>
        <auto_start>true</auto_start>
        <trajectory id="0" type="walk">
        <waypoint><time>0.00</time><pose>4.5 -2.6 0 0 0 0.000</pose></waypoint>
        <waypoint><time>7.33</time><pose>7.8 -2.6 0 0 0 1.571</pose></waypoint>
        <waypoint><time>18.89</time><pose>7.8 2.6 0 0 0 3.142</pose></waypoint>
        <waypoint><time>26.22</time><pose>4.5 2.6 0 0 0 -1.571</pose></waypoint>
        <waypoint><time>37.78</time><pose>4.5 -2.6 0 0 0 0.000</pose></waypoint>
        </trajectory>
      </script>
    </actor>

    <!-- ============ LIMO PRO ROBOT ============ -->
    <!-- Spawn at the west end, facing east. Planning/odom frame origin =
         this spawn pose (yaw 0), so scenario waypoints are world + (9, 0).
         PosePublisher provides ground-truth world pose on /model/limo/pose
         for validation grading (SceneBroadcaster's dynamic_pose topic
         segfaults gz-sim 8.11 on macOS when subscribed). -->
    <include>
      <uri>model://limo_pro</uri>
      <name>limo</name>
      <!-- Spawn height: wheel bottoms must clear the ground plane. 0.055 put
           the wheels (z -0.03, r 0.045) 2cm INSIDE the ground; the t=0
           physics settle ejected/slid the robot without wheel odometry
           recording it, rigidly offsetting the odom frame from the world
           (~0.25 rad + 0.6m measured) and displacing every projected
           obstacle. 0.075 rests the wheels exactly on the plane. -->
      <pose>-9 0 0.075 0 0 0</pose>
      <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
        <publish_model_pose>true</publish_model_pose>
        <publish_link_pose>false</publish_link_pose>
        <publish_collision_pose>false</publish_collision_pose>
        <publish_visual_pose>false</publish_visual_pose>
        <publish_sensor_pose>false</publish_sensor_pose>
        <use_pose_vector_msg>false</use_pose_vector_msg>
        <update_frequency>20</update_frequency>
      </plugin>
    </include>

  </world>
</sdf>
