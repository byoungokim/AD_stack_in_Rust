<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="limo_pro">
    <static>false</static>

    <!-- ============ CHASSIS ============ -->
    <link name="base_link">
      <inertial>
        <mass>4.5</mass>
        <inertia>
          <ixx>0.045</ixx><iyy>0.08</iyy><izz>0.09</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="chassis_visual">
        <geometry>
          <box><size>0.32 0.20 0.10</size></box>
        </geometry>
        <!-- High-visibility magenta: the one hue no building, actor, road,
             or wall in the generated worlds uses, with a mild emissive so
             the robot stays findable in shadow and on the bird's-eye view. -->
        <material>
          <ambient>1.0 0.0 0.85 1</ambient>
          <diffuse>1.0 0.05 0.85 1</diffuse>
          <emissive>0.35 0.0 0.3 1</emissive>
        </material>
      </visual>
      <collision name="chassis_collision">
        <geometry>
          <box><size>0.32 0.20 0.10</size></box>
        </geometry>
      </collision>

      <!-- Ground-truth accident detection: fires on any physical contact
           with the chassis (pedestrian models, buildings, walls, parked
           obstacles). Consumed by simulation/bridge/accident_monitor.py.
           Requires the world to load gz-sim-contact-system (all generated
           and shipped worlds do). Vehicle actors have no collision body, so
           car overlaps are detected perceptually by the monitor instead. -->
      <sensor name="chassis_contact" type="contact">
        <always_on>true</always_on>
        <update_rate>20</update_rate>
        <topic>limo/contacts</topic>
        <contact>
          <collision>chassis_collision</collision>
        </contact>
      </sensor>

      <!-- ============ CAMERA SENSOR ============ -->
      <sensor name="camera" type="camera">
        <pose>0.16 0 0.12 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <topic>limo/camera</topic>
        <camera>
          <horizontal_fov>1.2</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip><near>0.05</near><far>50</far></clip>
        </camera>
      </sensor>

      <!-- ============ LIDAR SENSOR ============ -->
      <sensor name="lidar" type="gpu_lidar">
        <pose>0.0 0 0.15 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <topic>limo/lidar</topic>
        <lidar>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>6.28318</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.1</min>
            <max>12.0</max>
            <resolution>0.01</resolution>
          </range>
        </lidar>
      </sensor>

      <!-- ============ IMU SENSOR ============ -->
      <sensor name="imu" type="imu">
        <pose>0 0 0.05 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <topic>limo/imu</topic>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.001</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.001</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.001</stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.02</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.02</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.02</stddev></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>
    </link>

    <!-- ============ REAR LEFT WHEEL ============ -->
    <link name="rear_left_wheel">
      <pose>-0.1 0.096 -0.03 -1.5707 0 0</pose>
      <inertial>
        <mass>0.3</mass>
        <inertia>
          <ixx>0.0002</ixx><iyy>0.0002</iyy><izz>0.0003</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry><cylinder><radius>0.045</radius><length>0.03</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
      </visual>
      <collision name="collision">
        <geometry><cylinder><radius>0.045</radius><length>0.03</length></cylinder></geometry>
        <surface>
          <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
        </surface>
      </collision>
    </link>
    <joint name="rear_left_wheel_joint" type="revolute">
      <parent>base_link</parent><child>rear_left_wheel</child>
      <axis><xyz>0 0 1</xyz></axis>
    </joint>

    <!-- ============ REAR RIGHT WHEEL ============ -->
    <link name="rear_right_wheel">
      <pose>-0.1 -0.096 -0.03 -1.5707 0 0</pose>
      <inertial>
        <mass>0.3</mass>
        <inertia>
          <ixx>0.0002</ixx><iyy>0.0002</iyy><izz>0.0003</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry><cylinder><radius>0.045</radius><length>0.03</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
      </visual>
      <collision name="collision">
        <geometry><cylinder><radius>0.045</radius><length>0.03</length></cylinder></geometry>
        <surface>
          <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
        </surface>
      </collision>
    </link>
    <joint name="rear_right_wheel_joint" type="revolute">
      <parent>base_link</parent><child>rear_right_wheel</child>
      <axis><xyz>0 0 1</xyz></axis>
    </joint>

    <!-- ============ FRONT LEFT STEERING + WHEEL ============ -->
    <link name="front_left_steering">
      <pose>0.1 0.096 -0.03 0 0 0</pose>
      <inertial><mass>0.05</mass>
        <inertia><ixx>0.00001</ixx><iyy>0.00001</iyy><izz>0.00001</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
    </link>
    <joint name="front_left_steering_joint" type="revolute">
      <parent>base_link</parent><child>front_left_steering</child>
      <axis><xyz>0 0 1</xyz>
        <limit><lower>-0.48</lower><upper>0.48</upper><effort>1e6</effort></limit>
      </axis>
    </joint>

    <link name="front_left_wheel">
      <pose>0.1 0.096 -0.03 -1.5707 0 0</pose>
      <inertial>
        <mass>0.3</mass>
        <inertia>
          <ixx>0.0002</ixx><iyy>0.0002</iyy><izz>0.0003</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry><cylinder><radius>0.045</radius><length>0.03</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
      </visual>
      <collision name="collision">
        <geometry><cylinder><radius>0.045</radius><length>0.03</length></cylinder></geometry>
        <surface>
          <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
        </surface>
      </collision>
    </link>
    <joint name="front_left_wheel_joint" type="revolute">
      <parent>front_left_steering</parent><child>front_left_wheel</child>
      <axis><xyz>0 0 1</xyz></axis>
    </joint>

    <!-- ============ FRONT RIGHT STEERING + WHEEL ============ -->
    <link name="front_right_steering">
      <pose>0.1 -0.096 -0.03 0 0 0</pose>
      <inertial><mass>0.05</mass>
        <inertia><ixx>0.00001</ixx><iyy>0.00001</iyy><izz>0.00001</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
    </link>
    <joint name="front_right_steering_joint" type="revolute">
      <parent>base_link</parent><child>front_right_steering</child>
      <axis><xyz>0 0 1</xyz>
        <limit><lower>-0.48</lower><upper>0.48</upper><effort>1e6</effort></limit>
      </axis>
    </joint>

    <link name="front_right_wheel">
      <pose>0.1 -0.096 -0.03 -1.5707 0 0</pose>
      <inertial>
        <mass>0.3</mass>
        <inertia>
          <ixx>0.0002</ixx><iyy>0.0002</iyy><izz>0.0003</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry><cylinder><radius>0.045</radius><length>0.03</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
      </visual>
      <collision name="collision">
        <geometry><cylinder><radius>0.045</radius><length>0.03</length></cylinder></geometry>
        <surface>
          <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
        </surface>
      </collision>
    </link>
    <joint name="front_right_wheel_joint" type="revolute">
      <parent>front_right_steering</parent><child>front_right_wheel</child>
      <axis><xyz>0 0 1</xyz></axis>
    </joint>

    <!-- ============ ACKERMANN STEERING PLUGIN ============ -->
    <plugin filename="gz-sim-ackermann-steering-system"
            name="gz::sim::systems::AckermannSteering">
      <left_joint>front_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <left_steering_joint>front_left_steering_joint</left_steering_joint>
      <right_steering_joint>front_right_steering_joint</right_steering_joint>
      <kingpin_width>0.192</kingpin_width>
      <steering_limit>0.48</steering_limit>
      <!-- Steering-joint P gain: the plugin default (1.0) gave the plant a
           measured first-order steering response of 0.53x gain at 440ms lag
           (tools/measure_tracking.py on demo27) — every tracking law weaved
           around that sluggishness. 8.0 makes the steering joints track the
           commanded angle within ~1-2 control cycles, matching the real
           Limo Pro servo's much faster response. -->
      <steer_p_gain>8.0</steer_p_gain>
      <wheel_base>0.2</wheel_base>
      <wheel_separation>0.192</wheel_separation>
      <wheel_radius>0.045</wheel_radius>
      <topic>limo/cmd_vel</topic>
      <odom_topic>limo/odom</odom_topic>
      <tf_topic>limo/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publish_frequency>20</odom_publish_frequency>
    </plugin>

    <!-- Joint state publisher for odometry -->
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <topic>limo/joint_states</topic>
    </plugin>

  </model>
</sdf>
